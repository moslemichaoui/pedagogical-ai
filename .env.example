# ---------------------------------------------------------------------------
# Pedagogical AI — environment template
#
# Copy this file to `.env` and replace only the values you need:
#   cp .env.example .env        (POSIX)
#   copy .env.example .env      (Windows)
#
# config.py loads `.env` from the project root once at import time. The `.env`
# file is git-ignored. NEVER commit real API keys or a production SECRET_KEY.
# Replace the SECRET_KEY example below with a long random value. Placeholder
# Gemini keys ("changeme", "your-gemini-api-key-here", empty values) are ignored
# by config.py: you will see a guided Arabic setup error instead of a confusing
# authentication failure.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Required outside tests. Replace this example with a long random value before
# starting the app; empty or placeholder values fail fast at startup.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# "true" / "1" / "yes" / "on" enable Flask debug mode. Leave off in production.
FLASK_DEBUG=false

# Optional. Leave blank to use sqlite:///<project>/instance/app.db.
# With Flask-SQLAlchemy 3, a relative URL such as sqlite:///app.db resolves
# inside the instance/ folder. This project has no Alembic setup.
DATABASE_URL=sqlite:///app.db

# --- Gemini generation -----------------------------------------------------
# At least one real key is required for AI generation and for embeddings.
# GEMINI_API_KEY plus GEMINI_API_KEY_1 ... GEMINI_API_KEY_5 are all read, in
# that order. Extra keys are used as fallback when a key is exhausted/invalid.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Model fallback chain, newest first: GEMINI_MODEL, then _1 ... _3.
# Leave every value blank to use the defaults: gemini-2.5-flash,
# gemini-2.0-flash. The API uses response_mime_type=application/json, not a
# Gemini response_schema.
GEMINI_MODEL=
GEMINI_MODEL_1=
GEMINI_MODEL_2=
GEMINI_MODEL_3=

# Gemini text-embedding model used to index documents and embed queries.
# Default: text-embedding-004
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Request timeout in seconds (clamped to 10-300). Default: 90
GEMINI_TIMEOUT_SECONDS=90

# Sampling temperature. Default: 0.25
GEMINI_TEMPERATURE=0.25

# Maximum output tokens (clamped to 1024-65536). Default: 8192
GEMINI_MAX_OUTPUT_TOKENS=8192

# --- Storage ---------------------------------------------------------------
# Uploaded source files, exported DOCX files, and the persistent Chroma index.
# Paths may be absolute or relative to the process working directory.
UPLOAD_FOLDER=uploads
EXPORT_FOLDER=exports
CHROMA_PERSIST_DIR=chromadb_data

# Maximum request body in MB (clamped to 1-100). Default: 25.
# Note: ExtractionService currently enforces its own 25 MB hard cap as well.
MAX_UPLOAD_MB=25

# --- Retrieval / RAG -------------------------------------------------------
# Number of chunks retrieved for a query (clamped to 1-20). Default: 6
RAG_TOP_K=6

# Minimum cosine similarity for vector hits (fall back to lexical ranking when
# no hit clears the threshold). Default: 0.15
RAG_MIN_SIMILARITY=0.15

# Chunk size in characters (clamped to 200-3000). Default: 700
CHUNK_SIZE=700

# Overlap between chunks in characters (clamped to 0-500). Default: 80
CHUNK_OVERLAP=80

# --- Product limits --------------------------------------------------------
# Rolling one-hour limits per client address, per process (no Redis).
# Defaults: 20 generations/hour, 30 uploads/hour.
RATE_LIMIT_GENERATE=20
RATE_LIMIT_UPLOAD=30

# Comma-separated proxy IPs allowed to set X-Forwarded-For for rate limiting.
# Leave empty locally. Behind a proxy, set this to the proxy address; otherwise
# the limiter keys on request.remote_addr.
TRUSTED_PROXIES=
